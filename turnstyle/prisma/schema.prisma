// Turnstyle - Prisma Schema
// Run: npx prisma migrate dev --name init
// DB:  DATABASE_URL="postgresql://user:pass@localhost:5432/turnstyle"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  
  promoterId       String?          @map("promoter_id")
  promoter         Promoter?        @relation("UserPromoter", fields: [promoterId], references: [id])
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaigns        Campaign[]
  approvals        ApprovalRecord[]
  summaryEdits     Summary[]
  generatedDocs    GeneratedDocument[]
  auditLogs        AuditLog[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENCY_ADMIN
  CLIENT
}

model Promoter {
  id           String   @id @default(uuid())
  name         String
  abn          String?
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  address      String?  @map("address")
users        User[]            @relation("UserPromoter")
templates    PromoterTemplate[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@map("promoters")
}

model Campaign {
  id             String         @id @default(uuid())
  tsCode         String         @unique @map("ts_code")
  promoterId     String?        @map("promoter_id")
  createdById    String         @map("created_by_id")
  name           String         @unique
  promoStart     DateTime?      @map("promo_start") @db.Date
  promoEnd       DateTime?      @map("promo_end") @db.Date
  mechanicType   MechanicType   @default(OTHER) @map("mechanic_type")
  entryMechanic  String?        @map("entry_mechanic")
  drawSchedule   Json?          @map("draw_schedule")
  drawFrequency  DrawFrequency  @default(AT_CONCLUSION) @map("draw_frequency")
  regions        String[]
  prizes         Json           @default("[]")
  prizePoolTotal Decimal        @default(0) @map("prize_pool_total") @db.Decimal(12, 2)
  notes          String?
  status         CampaignStatus @default(DRAFT)
  version        Int            @default(1)
  permitNSW      String?        @map("permit_nsw")
  permitSA       String?        @map("permit_sa")
  permitACT     String?        @map("permit_act")
  permitLOASigned Boolean       @default(false) @map("permit_loa_signed")
  drawDatasetUploadedAt DateTime? @map("draw_dataset_uploaded_at")
  winnersConfirmedAt    DateTime? @map("winners_confirmed_at")
  threadMessageId       String?        @map("thread_message_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  prizesConfirmed    Boolean   @default(false) @map("prizes_confirmed")
  drawConfirmed      Boolean   @default(false) @map("draw_confirmed")
  confirmedPrizes    Json?     @map("confirmed_prizes")
  maxStatePool    Float?   @default(0) @map("max_state_pool")
requiredPermits String[] @map("required_permits")
  dropboxFolderUrl String? @map("dropbox_folder_url")
  intakeSummary    String? @map("intake_summary") @db.Text
  preflightScore   Int?    @map("preflight_score")
  invoiceOpsStatus InvoiceOpsStatus @default(NOT_STARTED) @map("invoice_ops_status")
  opsNotes         String? @map("ops_notes") @db.Text

  promoter      Promoter?           @relation(fields: [promoterId], references: [id])
  createdBy     User                @relation(fields: [createdById], references: [id])
  quotes        Quote[]
  summaries     Summary[]
  documents     GeneratedDocument[]
  auditLogs     AuditLog[]
  termsDrafts   TermsDraft[]
  opsDocuments  PromotionDocument[]
  opsDraws      PromotionDraw[]

  @@map("campaigns")
}

enum InvoiceOpsStatus {
  NOT_STARTED
  REQUIRED
  ISSUED
  PAID
  NOT_APPLICABLE
}

enum OpsDocumentStatus {
  NOT_STARTED
  REQUIRED
  WAITING_ON_CLIENT
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  LODGED
  RECEIVED
  COMPLETE
  OVERDUE
  NOT_APPLICABLE
}

enum DrawFileStatus {
  NOT_REQUIRED
  REQUIRED
  REQUESTED
  RECEIVED
  CHECKED
  READY_FOR_DRAW
  USED_IN_DRAW
  ARCHIVED
}

enum DrawCertificateStatus {
  NOT_STARTED
  GENERATED
  REVIEWED
  SENT_TO_CLIENT
  SAVED_TO_DROPBOX
}

model PromotionDocument {
  id              String            @id @default(uuid())
  campaignId      String            @map("campaign_id")
  fileType        String            @map("file_type")
  folderLabel     String?           @map("folder_label")
  required        Boolean           @default(true)
  status          OpsDocumentStatus @default(NOT_STARTED)
  dueDate         DateTime?         @map("due_date") @db.Date
  dropboxFolder   String?           @map("dropbox_folder")
  dropboxFileUrl  String?           @map("dropbox_file_url")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, fileType])
  @@index([campaignId])
  @@index([status])
  @@map("promotion_documents")
}

model PromotionDraw {
  id                    String                @id @default(uuid())
  campaignId            String                @map("campaign_id")
  drawName              String                @map("draw_name")
  drawNumber            Int                   @map("draw_number")
  drawDate              DateTime              @map("draw_date") @db.Date
  drawTime              String?               @map("draw_time")
  drawLocation          String?               @map("draw_location")
  entryPeriodStart      DateTime?             @map("entry_period_start") @db.Date
  entryPeriodEnd        DateTime?             @map("entry_period_end") @db.Date
  entryFileRequired     Boolean               @default(true) @map("entry_file_required")
  entryFileStatus       DrawFileStatus        @default(REQUIRED) @map("entry_file_status")
  entryFileDropboxUrl   String?               @map("entry_file_dropbox_url")
  purerandomDrawStatus  String?               @map("purerandom_draw_status")
  certificateStatus     DrawCertificateStatus @default(NOT_STARTED) @map("certificate_status")
  certificateDropboxUrl String?               @map("certificate_dropbox_url")
  winnerNotifyDue       DateTime?             @map("winner_notify_due") @db.Date
  winnerNotifyStatus    OpsDocumentStatus     @default(NOT_STARTED) @map("winner_notify_status")
  publicationRequired   Boolean               @default(false) @map("publication_required")
  publicationDue        DateTime?             @map("publication_due") @db.Date
  publicationStatus     OpsDocumentStatus     @default(NOT_STARTED) @map("publication_status")
  permitReference       String?               @map("permit_reference")
  notes                 String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([drawDate])
  @@map("promotion_draws")
}

model PromoterTemplate {
  id             String        @id @default(uuid())
  promoterId     String        @map("promoter_id")
  name           String
  templateFileId String        @map("template_file_id")
  entryMechanic  String?       @map("entry_mechanic")
  regions        String[]
  drawSchedule   Json?          @map("draw_schedule")
  drawFrequency  DrawFrequency @default(AT_CONCLUSION) @map("draw_frequency")
  mechanicType   MechanicType  @default(OTHER) @map("mechanic_type")
  notes          String?
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  promoter Promoter @relation(fields: [promoterId], references: [id])

  @@map("promoter_templates")
}

enum MechanicType {
  SWEEPSTAKES
  LIMITED_OFFER
  INSTANT_WIN
  GAME_OF_SKILL
  OTHER
  DRAW_ONLY
}

enum DrawFrequency {
  AT_CONCLUSION
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  HOURLY
}

enum CampaignStatus {
  DRAFT
  CONFIRMED
  COMPILED
  REVIEW
  PENDING
  SCHEDULED
  LIVE
  CLOSED
  DRAWN
  ARCHIVED
}

enum TermsDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  LOCKED
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model Quote {
  id             String      @id @default(uuid())
  campaignId     String      @map("campaign_id")
  quoteNumber    String      @map("quote_number")
  quoteHash      String      @map("quote_hash")
  status         QuoteStatus @default(DRAFT)
  termsFee       Decimal     @map("terms_fee") @db.Decimal(10, 2)
  mgmtFee        Decimal     @map("mgmt_fee") @db.Decimal(10, 2)
  permitFee      Decimal     @map("permit_fee") @db.Decimal(10, 2)
  drawFee        Decimal     @map("draw_fee") @db.Decimal(10, 2)
  totalExGst     Decimal     @map("total_ex_gst") @db.Decimal(10, 2)
  gstAmount      Decimal     @map("gst_amount") @db.Decimal(10, 2)
  totalIncGst    Decimal     @map("total_inc_gst") @db.Decimal(10, 2)
  currency       String      @default("AUD")
  validUntil     DateTime    @map("valid_until") @db.Date
  engineVersion  String      @map("engine_version")
  snapshotJson   Json        @map("snapshot_json")
  approvedAt     DateTime?   @map("approved_at")
  approvedById   String?     @map("approved_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  campaign  Campaign        @relation(fields: [campaignId], references: [id])
  approval  ApprovalRecord?

  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  ACCEPTED
  SUPERSEDED
  EXPIRED
}

model ApprovalRecord {
  id                String   @id @default(uuid())
  quoteId           String   @unique @map("quote_id")
  campaignId        String   @map("campaign_id")
  approvedById      String   @map("approved_by_id")
  approvedAt        DateTime @map("approved_at")
  totalSnapshot     Decimal  @map("total_snapshot") @db.Decimal(10, 2)
  quoteHashSnapshot String   @map("quote_hash_snapshot")
  notes             String?
  ipAddress         String?  @map("ip_address")

  quote      Quote @relation(fields: [quoteId], references: [id])
  approvedBy User  @relation(fields: [approvedById], references: [id])

  @@map("approval_records")
}

model Summary {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  version    Int
  contentJson Json    @map("content_json")
  isCurrent  Boolean  @default(true) @map("is_current")
  editedById String   @map("edited_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  editedBy User     @relation(fields: [editedById], references: [id])

  @@unique([campaignId, version])
  @@map("summaries")
}

model TermsTemplate {
  id           String       @id @default(uuid())
  name         String
  type         TemplateType
  jurisdiction String
  version      Int
  isActive     Boolean      @default(true) @map("is_active")
  clausesJson  Json         @map("clauses_json")
  createdAt    DateTime     @default(now()) @map("created_at")

  clauses TermsClause[]

  @@map("terms_templates")
}

enum TemplateType {
  ABBREVIATED
  FULL
}

model TermsClause {
  id            String  @id @default(uuid())
  templateId    String  @map("template_id")
  slug          String
  title         String
  bodyHtml      String  @map("body_html")
  conditionJson Json?   @map("condition_json")
  jurisdiction  String
  version       Int
  isActive      Boolean @default(true) @map("is_active")

  template TermsTemplate @relation(fields: [templateId], references: [id])

  @@map("terms_clauses")
}

model GeneratedDocument {
  id            String       @id @default(uuid())
  campaignId    String       @map("campaign_id")
  type          DocumentType
  version       Int
  s3Key         String?      @map("s3_key")
  s3Url         String?      @map("s3_url")
  mimeType      String       @map("mime_type")
  generatedAt   DateTime     @default(now()) @map("generated_at")
  generatedById String       @map("generated_by_id")
  expiresAt     DateTime?    @map("expires_at")

  campaign    Campaign @relation(fields: [campaignId], references: [id])
  generatedBy User     @relation(fields: [generatedById], references: [id])

  @@map("generated_documents")
}

enum DocumentType {
  QUOTE
  ABBREV_TERMS
  FULL_TERMS
  QR_CODE
}

model AuditLog {
  id           String   @id @default(uuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  action       String
  actorId      String   @map("actor_id")
  diffJson     Json?    @map("diff_json")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor      User     @relation(fields: [actorId], references: [id])
  campaign   Campaign @relation(fields: [entityId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model TermsDraft {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  version     Int      @default(1)
  content     String
  gapAnswers  Json
  templateId  String   @map("template_id")
  status      TermsDraftStatus @default(DRAFT)
  shareToken  String   @unique @map("share_token")
  sharedAt    DateTime? @map("shared_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign  Campaign        @relation(fields: [campaignId], references: [id])
  comments  TermsComment[]
  approvals TermsApproval[]

  @@map("terms_drafts")
}

model TermsComment {
  id            String   @id @default(uuid())
  termsDraftId  String   @map("terms_draft_id")
  clauseSlug    String   @map("clause_slug")
  authorName    String   @map("author_name")
  authorEmail   String   @map("author_email")
  body          String
  status        CommentStatus @default(OPEN)
  createdAt     DateTime @default(now()) @map("created_at")

  draft TermsDraft @relation(fields: [termsDraftId], references: [id])

  @@map("terms_comments")
}

model TermsApproval {
  id            String   @id @default(uuid())
  termsDraftId  String   @map("terms_draft_id")
  approverName  String   @map("approver_name")
  approverEmail String   @map("approver_email")
  status        ApprovalStatus @default(PENDING)
  note          String?
  respondedAt   DateTime? @map("responded_at")
  createdAt     DateTime @default(now()) @map("created_at")

  draft TermsDraft @relation(fields: [termsDraftId], references: [id])

  @@map("terms_approvals")
}

// ─── Standalone Preflight Upload ──────────────
// Parallel path: upload an existing .docx for preflight
// without requiring a campaign to exist in the wizard flow.

model TermsUpload {
  id            String    @id @default(uuid())
  filename      String
  fileSize      Int       @map("file_size")
  extractedText String    @map("extracted_text") @db.Text
  wordCount     Int       @default(0) @map("word_count")
  uploadedAt    DateTime  @default(now()) @map("uploaded_at")

  report        TermsUploadReport?

  @@map("terms_uploads")
}

model TermsUploadReport {
  id              String      @id @default(uuid())
  uploadId        String      @unique @map("upload_id")
  score           Int
  riskBand        String      @map("risk_band")
  issueCount      Int         @map("issue_count")
  reportJson      Json        @map("report_json")
  extractionJson  Json?       @map("extraction_json")
  reviewJson      Json?       @map("review_json")
  recommendation  String?
  draftSeedJson   Json?       @map("draft_seed_json")
  createdAt       DateTime    @default(now()) @map("created_at")

  upload TermsUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@map("terms_upload_reports")
}

// Campaign brief received via email (Resend Inbound), partner API, or demo — draft until sent to builder.
model CampaignIntakeDraft {
  id               String   @id @default(uuid())
  reviewToken      String   @unique @map("review_token")
  packetRef        String?  @unique @map("packet_ref")
  partnerId        String?  @map("partner_id")
  submitterName    String?  @map("submitter_name")
  submitterEmail   String?  @map("submitter_email")
  submitterCompany String?  @map("submitter_company")
  externalRef      String?  @map("external_ref")
  idempotencyKey   String?  @map("idempotency_key")
  fromEmail        String?  @map("from_email")
  subject          String?
  resendEmailId    String?  @map("resend_email_id")
  rawInput         String   @map("raw_input") @db.Text
  intakeJson       Json     @map("intake_json")
  source           String   @default("mock")
  status           String   @default("pending_review")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([partnerId, idempotencyKey])
  @@index([partnerId])
  @@index([submitterEmail])
  @@map("campaign_intake_drafts")
}

// Partner API credentials — store hashed secrets only.
model PartnerApiCredential {
  id                String   @id @default(uuid())
  partnerId         String   @unique @map("partner_id")
  displayName       String   @map("display_name")
  apiKeyHash        String   @map("api_key_hash")
  apiKeyPrefix      String   @map("api_key_prefix")
  isActive          Boolean  @default(true) @map("is_active")
  rateLimitPerMin   Int      @default(30) @map("rate_limit_per_min")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("partner_api_credentials")
}